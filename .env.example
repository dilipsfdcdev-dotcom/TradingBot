# ============================================================
# MT5 connection via MetaApi (https://metaapi.cloud)
# 1. Create a free MetaApi account
# 2. Link your MT5 account (broker login + investor/master password)
# 3. Copy the API token and the MetaApi account id below
# ============================================================
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Optional: Telegram notifications (trade alerts, kill-switch alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
