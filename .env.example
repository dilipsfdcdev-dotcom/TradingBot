# ─────────────────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your real values.  NEVER commit .env
# ─────────────────────────────────────────────────────────────────────────

# --- MetaTrader 5 login (from your broker) -------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Demo
# Optional: full path to terminal64.exe if MT5 is not auto-detected
MT5_PATH=

# --- Trading mode --------------------------------------------------------
# DEMO  -> safe, paper money (default, recommended to start)
# LIVE  -> real money. Only switch after you trust the bot on DEMO.
TRADING_MODE=DEMO

# --- News API (optional, improves the news filter) -----------------------
# Free key from https://newsapi.org  (leave blank to use free RSS feeds only)
NEWSAPI_KEY=

# --- Dashboard ----------------------------------------------------------
DASHBOARD_PORT=8501
