# Copy to .env and edit. All distances are in PRICE units (gold: 1.0 = $1 move).

# --- Webhook ---
WEBHOOK_SECRET=change-me-to-a-long-random-string
HOST=0.0.0.0
# TradingView only delivers webhooks to port 80 or 443.
PORT=80
# Optional: comma-separated IPs allowed to call the webhook (TradingView publishes its webhook IPs).
ALLOWED_IPS=
# Dashboard (http://localhost/dashboard) always opens on this machine. To open it from another
# device, set a password here; leave blank to keep it local-only. Sent over plain HTTP.
DASHBOARD_PASSWORD=

# --- MT5 ---
MT5_PATH=C:\MT5_Bridge\terminal64.exe
# true if that terminal is started with the /portable switch.
MT5_PORTABLE=true
# Leave blank to use the account already logged in to the terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# true = validate orders with the broker but never send them.
DRY_RUN=false

# --- Symbols ---
DEFAULT_SYMBOL=XAUUSD
# TradingView ticker = MT5 symbol. Signals for any other ticker are rejected.
SYMBOL_MAP=XAUUSD=XAUUSD,GOLD=XAUUSD
MAGIC=770011

# --- Position size ---
LOT=0.01
MAX_LOT=1.0
# If > 0, size each trade to risk this % of account equity at the stop-loss (overrides LOT).
RISK_PERCENT=5

# --- Stops ---
SL_DISTANCE=5.0
# 0 = no take-profit (exit by trailing stop or opposite signal).
TP_DISTANCE=0
# Start trailing once profit reaches TRAIL_START; keep the stop TRAIL_DISTANCE behind price;
# only move it when it improves by at least TRAIL_STEP.
TRAIL_START=2.0
TRAIL_DISTANCE=1.5
TRAIL_STEP=0.2
# Optional: move the stop to entry + BREAKEVEN_OFFSET once profit reaches BREAKEVEN_AT (0 = off).
BREAKEVEN_AT=0
BREAKEVEN_OFFSET=0.1

# --- Re-entry ---
# The indicator only alternates buy/sell. If a trade is stopped out while the last signal still
# stands, re-enter in that direction when price pushes REENTRY_BUFFER beyond the best price reached
# so far (new high for a buy, new low for a sell). At most REENTRY_MAX times per signal (0 = off),
# and not within REENTRY_COOLDOWN_SEC of the exit. Each re-entry is a full-size, full-risk trade.
REENTRY_MAX=2
REENTRY_BUFFER=0.5
REENTRY_COOLDOWN_SEC=60

# --- Safety ---
# Do not open if the spread is wider than this (opposite positions are still closed).
MAX_SPREAD=0.5
DEVIATION_POINTS=200
# Open trades allowed at once: in total, and on the same symbol. A repeat signal adds a
# position until the limit is reached (1 = never stack).
MAX_OPEN_POSITIONS=2
MAX_POSITIONS_PER_SYMBOL=2
# 0 = no limit.
MAX_TRADES_PER_DAY=0
# Kill switch: when today's loss (UTC day, whole account) reaches this % of the day's starting
# balance, close all bridge positions and take no new trades until tomorrow. 0 = off.
MAX_DAILY_LOSS_PERCENT=50
MAX_SIGNAL_AGE_SEC=30
DEDUP_WINDOW_SEC=3
TRAIL_POLL_MS=200
